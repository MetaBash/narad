## Environment Variables ##

# Server Port
PORT = "Your_Port"
# Example: 3001

# Server URI
SERVER_URI = "http://localhost:{PORT}"

# Database Name
DB_NAME = "Your_DB_Name"

# Collection Names
ORG = "org"
USER = "user"
CAM = "camera"
NARAD = "narad"

# DB User
DB_USER = "Your_DB_User"

# DB Password
DB_PASS = "Your_DB_Password"

# MongoDB URI
MONGO_URI = "mongodb+srv://{DB_USER}:{DB_PASS}@narad.p13.mongodb.net"
# Note: Use your own MongoDB URI

# SMTP Host
SMTP_HOST = "smtp.gmail.com"

# SMTP Port
SMTP_PORT = "587"

# SMTP User
SMTP_USER = "Your_Email"

# SMTP Password
SMTP_PASS = "Your_Password"
# Note: Use your own SMTP Password